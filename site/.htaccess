# Conservation Dwelling: HTTPS and clean page addresses (/about serves about.html)
Options -Indexes
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Anything else that does not exist gets the designed 404 page
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/404\.php$
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ /404.php [L]

# Keep the deployment record private
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# Pages are always rechecked; versioned files can be kept for a long time
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|jpe?g|png|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(favicon\.ico|favicon-32\.png|apple-touch-icon\.png)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
